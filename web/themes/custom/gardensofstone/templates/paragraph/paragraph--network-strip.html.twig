{#
/**
 * @file
 * Theme implementation to display a network strip paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--network-strip',
    'network-strip',
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      <div class="wrap container    network-inner">
        <div style="flex:1;min-width:260px;">
            {% if paragraph.field_pbnet_kicker and not paragraph.field_pbnet_kicker.isEmpty() %}
                <div class="network-kicker">{{ content.field_pbnet_kicker }}</div>
            {% endif %}
          {% if paragraph.field_pbnet_title and not paragraph.field_pbnet_title.isEmpty() %}
            <div class="network-stat">{{ content.field_pbnet_title }}</div>
          {% endif %}
          {% if paragraph.field_pbnet_lede and not paragraph.field_pbnet_lede.isEmpty() %}
            <div class="network-text">{{ content.field_pbnet_lede }}</div>
          {% endif %}
          {% if paragraph.field_pbnet_form and not paragraph.field_pbnet_form.isEmpty() %}
            <div class="subscribe-row">
              {{ content.field_pbnet_form }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endblock %}
  </div>
{% endblock paragraph %}
