{#
/**
 * @file
 * Theme implementation to display a network strip paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--network-strip',
    'network-strip',
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      <div class="wrap network-inner">
        <div style="flex:1;min-width:260px;">
          {% if paragraph.field_pbnetwork_stat and not paragraph.field_pbnetwork_stat.isEmpty() %}
            <div class="network-stat">{{ content.field_pbnetwork_stat }}</div>
          {% endif %}
          {% if paragraph.field_pbnetwork_text and not paragraph.field_pbnetwork_text.isEmpty() %}
            <div class="network-text">{{ content.field_pbnetwork_text }}</div>
          {% endif %}
          {% if paragraph.field_pbnetwork_form and not paragraph.field_pbnetwork_form.isEmpty() %}
            <div class="subscribe-row">
              {{ content.field_pbnetwork_form }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endblock %}
  </div>
{% endblock paragraph %}
