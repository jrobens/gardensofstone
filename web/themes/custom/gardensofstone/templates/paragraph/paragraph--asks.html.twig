{#
/**
 * @file
 * Theme implementation to display an asks section paragraph.
 */
#}
{%
    set classes = [
    'paragraph',
    'paragraph--type--asks',
    'asks-section',
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
]
%}
{% block paragraph %}
    <div{{ attributes.addClass(classes) }}>
        {% block content %}
            <div class="wrap container">
                {% if not paragraph.field_pbasks_kicker.isEmpty() %}
                    <div class="kicker">{{ content.field_pbasks_kicker }}</div>
                {% endif %}

                {% if not paragraph.field_pbasks_title.isEmpty() %}
                    <h2 class="title">{{ content.field_pbasks_title }}</h2>
                {% endif %}

                {% if not paragraph.field_pbasks_standout_lede.isEmpty() %}
                    <div class="standout-lede">{{ content.field_pbasks_standout_lede }}</div>
                {% endif %}

                {% if not paragraph.field_pbasks_copy_note.isEmpty() %}
                    <div class="copy-note">{{ content.field_pbasks_copy_note }}</div>
                {% endif %}

                {% if not paragraph.field_pbasks_cards.isEmpty() %}
                    <div class="asks-grid">
                        {{ content.field_pbasks_cards }}
                    </div>
                {% endif %}
            </div>
        {% endblock %}
    </div>
{% endblock paragraph %}
