{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 8 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "civicrm/civicrm-asset-plugin": "~1.1",
        "civicrm/civicrm-drupal-8": "^6.4",
        "civicrm/civicrm-packages": "^6.4",
        "composer/installers": "^1.2",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.3",
        "drupal/animate_on_scroll": "3.0.x-dev@dev",
        "drupal/better_social_sharing_buttons": "^4.0",
        "drupal/block_title_link": "^1.1",
        "drupal/ckeditor_media_embed": "2.x-dev@dev",
        "drupal/classy_paragraphs": "^2.0",
        "drupal/copyright_footer": "^3.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/dropzonejs": "^2.8",
        "drupal/drulma": "^2.0",
        "drupal/drulma_companion": "^2.1",
        "drupal/ds": "^3.9",
        "drupal/entity_body_class": "^2.0",
        "drupal/entity_class_formatter": "^2.0",
        "drupal/entity_clone": "^2.1@beta",
        "drupal/expand_collapse_formatter": "^2.0",
        "drupal/focal_point": "^2.0",
        "drupal/fontawesome": "^3.0",
        "drupal/fontawesome_menu_icons": "^3.0",
        "drupal/google_tag": "^2.0",
        "drupal/honeypot": "^2.1",
        "drupal/hook_event_dispatcher": "^4.2",
        "drupal/image_effects": "*",
        "drupal/layout_paragraphs": "2.1.x-dev@dev",
        "drupal/leaflet": "^10.0",
        "drupal/leaflet_more_maps": "^2.1",
        "drupal/linked_field": "^1.3",
        "drupal/lp_fontawesome": "^6.7",
        "drupal/markdown": "^3.1",
        "drupal/masquerade": "^2.0@RC",
        "drupal/media_bulk_upload": "^3.0",
        "drupal/mediteran": "1.x-dev@dev",
        "drupal/menu_item_extras": "^3.0",
        "drupal/menu_link_attributes": "^1.2",
        "drupal/metatag": "^2.1",
        "drupal/module_filter": "^5.0",
        "drupal/nagios": "^1.10",
        "drupal/paragraph_blocks": "^4.1",
        "drupal/paragraphs": "^1.12",
        "drupal/pathauto": "^1.8",
        "drupal/photos": "^6.1",
        "drupal/recaptcha_v3": "^2.0",
        "drupal/shield": "^1.4",
        "drupal/tfa": "^1.2",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.3@beta",
        "drupal/webform_xlsx_export": "^1.5",
        "drupal/xmlsitemap": "^2.0@beta",
        "drush/drush": "^13",
        "enyo/dropzone": "^5.7",
        "league/commonmark": "^1.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {

        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "wikimedia/composer-merge-plugin": true,
            "civicrm/civicrm-asset-plugin": true,
            "civicrm/composer-downloads-plugin": true,
            "civicrm/composer-compile-plugin": true
        }
    },
    "extra": {
        "enable-patching": "true",
        "patches": {
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/webform/composer.libraries.json",
                "web/modules/contrib/dropzonejs/composer.libraries.json",
                "web/modules/patched/fontawesome/composer.libraries.json",
                "web/modules/patched/fontawesome/composer.json"
            ]
        },
        "compile-whitelist": [
            "civicrm/composer-compile-lib",
            "civicrm/civicrm-core"
        ]
    }
}
