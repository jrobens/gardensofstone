{# Template: themes/custom/gardensofstone/templates/system/menu--bulma-navbar.html.twig #}
{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    <div class="navbar-start">
      {% for item in items %}
        {% set has_dropdown = item.below is not empty %}
        {% set unique_id = 'mega-menu-' ~ loop.index %}

        <div class="navbar-item {{ has_dropdown ? 'has-dropdown is-hoverable' : '' }}">
          {% set link_classes = ['navbar-link'] %}
          {% if not has_dropdown %}
            {% set link_classes = link_classes|merge(['is-arrowless']) %}
          {% endif %}
          {% if item.in_active_trail %}
            {% set link_classes = link_classes|merge(['is-active']) %}
          {% endif %}

          <a href="{{ item.url }}"
             class="{{ link_classes|join(' ') }}"
             {% if has_dropdown %}
               id="{{ unique_id }}-trigger"
               aria-expanded="false"
               aria-haspopup="true"
               aria-controls="{{ unique_id }}-dropdown"
             {% endif %}>
            {{ item.title }}
          </a>

          {% if has_dropdown %}
            {% set level1_image = item.content.field_menu_image|render ?: (item.content.field_things_to_do_image|render ?: '') %}
            <div id="{{ unique_id }}-dropdown" class="navbar-dropdown mega-menu-dropdown" aria-labelledby="{{ unique_id }}-trigger">
              <div class="mega-menu-wrapper">
                
                {# Single-Page Mega Menu Grid #}
                <div class="mega-menu-container {{ level1_image ? 'has-media' : 'no-media' }}">
                  
                  {# Left / Main Grid of Level 2 & Level 3 Items (All Open) #}
                  <div class="mega-menu-grid">
                    {% for sub_item in item.below %}
                      {% set sub_image = sub_item.content.field_menu_image|render ?: (sub_item.content.field_things_to_do_image|render ?: '') %}
                      {% set sub_desc = sub_item.content.field_menu_description|render ?: (sub_item.content.field_things_to_do_text|render ?: '') %}

                      <div class="mega-menu-column level-2-item {{ sub_image ? 'has-card-image' : '' }}">
                        
                        {# Level 2 Image #}
                        {% if sub_image %}
                          <div class="level-2-image-wrapper">
                            {{ sub_item.content.field_menu_image ?: sub_item.content.field_things_to_do_image }}
                          </div>
                        {% endif %}

                        {# Level 2 Header / Link #}
                        <div class="mega-menu-heading">
                          {% if sub_item.url and sub_item.url.toString() %}
                            <a href="{{ sub_item.url }}" class="mega-menu-title-link {{ sub_item.in_active_trail ? 'is-active' : '' }}">
                              {{ sub_item.title }}
                            </a>
                          {% elseif sub_item.content['#menu_link_content'] %}
                            {% set entity = sub_item.content['#menu_link_content'] %}
                            <span class="mega-menu-title">{{ entity.title.value }}</span>
                          {% else %}
                            <span class="mega-menu-title">{{ sub_item.title }}</span>
                          {% endif %}
                        </div>

                        {# Level 2 Description #}
                        {% if sub_desc %}
                          <div class="mega-menu-description">
                            {{ sub_item.content.field_menu_description ?: sub_item.content.field_things_to_do_text }}
                          </div>
                        {% endif %}

                        {# Level 3 Items (All Open) #}
                        {% if sub_item.below %}
                          <ul class="mega-menu-sublinks">
                            {% for sub_sub_item in sub_item.below %}
                              {% set sub_sub_image = sub_sub_item.content.field_menu_image|render ?: (sub_sub_item.content.field_things_to_do_image|render ?: '') %}
                              {% set sub_sub_desc = sub_sub_item.content.field_menu_description|render ?: (sub_sub_item.content.field_things_to_do_text|render ?: '') %}

                              <li class="level-3-item {{ sub_sub_image ? 'has-sub-image' : '' }}">
                                {% if sub_sub_image %}
                                  <div class="level-3-image">
                                    {{ sub_sub_item.content.field_menu_image ?: sub_sub_item.content.field_things_to_do_image }}
                                  </div>
                                {% endif %}

                                <div class="level-3-content">
                                  {% if sub_sub_item.url and sub_sub_item.url.toString() %}
                                    <a href="{{ sub_sub_item.url }}" class="mega-menu-sublink {{ sub_sub_item.in_active_trail ? 'is-active' : '' }}">
                                      {{ sub_sub_item.title }}
                                    </a>
                                  {% elseif sub_sub_item.content['#menu_link_content'] %}
                                    {% set sub_entity = sub_sub_item.content['#menu_link_content'] %}
                                    <span class="mega-menu-sublink-text">{{ sub_entity.title.value }}</span>
                                  {% else %}
                                    <span class="mega-menu-sublink-text">{{ sub_sub_item.title }}</span>
                                  {% endif %}

                                  {% if sub_sub_desc %}
                                    <div class="level-3-description">
                                      {{ sub_sub_item.content.field_menu_description ?: sub_sub_item.content.field_things_to_do_text }}
                                    </div>
                                  {% endif %}
                                </div>
                              </li>
                            {% endfor %}
                          </ul>
                        {% endif %}

                      </div>
                    {% endfor %}
                  </div>

                  {# Right-hand Featured / Showcase Image Column #}
                  {% if level1_image %}
                    <div class="mega-menu-media-column">
                      <div class="mega-menu-image-wrapper">
                        {{ item.content.field_menu_image ?: item.content.field_things_to_do_image }}
                      </div>
                    </div>
                  {% endif %}

                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endmacro %}
