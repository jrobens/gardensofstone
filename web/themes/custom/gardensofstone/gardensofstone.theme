<?php

/**
 * @file
 * The primary PHP file for the Drulma base theme.
 */

function gardensofstone_preprocess_html(&$variables, $hook)
{
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof \Drupal\node\NodeInterface) {
    $variables['attributes']['class'][] = Drupal::request()->getRequestUri();
    $requestUriNoArgs = \Drupal::request()->getRequestUri();
    $questionMarkPos = strpos($requestUriNoArgs, "?");
    if ($questionMarkPos) {
      $requestUriNoArgs = substr($requestUriNoArgs, 0, $questionMarkPos);
    }
    $requestUriNoArgs = ltrim($requestUriNoArgs, '/');
    $requestUri = str_replace('/', '-', $requestUriNoArgs);

    $variables['attributes']['class'][] = 'node-type--' . str_replace('_', '-', $node->bundle());
    $variables['attributes']['class'][] = 'path--' . $requestUri;
    if ($requestUri !== '') {
      $variables['attributes']['class'][] = 'not-front';
    }
  } else {
    $variables['attributes']['class'][] = 'not-front';
  }
}

function gardensofstone_preprocess_region(&$variables)
{
  // Add missing region CSS classes.
  $variables['attributes']['class'][] = 'region';
  if (isset($variables['region']) && !empty($variables['region'])) {
    $variables['attributes']['class'][] = 'region-' . str_replace('_', '-', $variables['region']);
  }
}

/**
 * Implements hook_preprocess_IMAGE().
 */
function gardensofstone_preprocess_image(&$variables) {
  // Remove the attributes completely
  unset($variables['attributes']['width']);
  unset($variables['attributes']['height']);
}


