<?php

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;

function crossfade_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.crossfade':
        $text = file_get_contents(dirname(__FILE__) . "/README.md");
        if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
            return '<pre>' . $text . '</pre>';
        }
        else {
            /** @var \Drupal\markdown\PluginManager\ParserManagerInterface $parser_manager */
            $parser_manager = \Drupal::service('plugin.manager.markdown.parser');
            $parser = $parser_manager->getDefaultParser([
                'render_strategy' => ['type' => 'none'],
            ]);
            return $parser->parse($text);
      }
  }
  return NULL;
}


/**
 * Implements hook_ENTITY_TYPE_view_alter() for node entities.
 */
function crossfade_paragraph_view_alter(array &$build, EntityInterface $node, EntityViewDisplayInterface $display) {
 if ($display->getTargetBundle() != 'crossfade_banner') {
   return;
 }

 $build['field_pbcrossfade_image']['#type'] = 'html_tag';
 $build['field_pbcrossfade_image']['#tag'] = 'div';
 $build['field_pbcrossfade_image']['#attributes']['id'] = 'CrossFade';
 $images_markup = '';
 // $build['field_pbcrossfade_image']['#items'] EntityReferenceFieldItemList
  foreach($build['field_pbcrossfade_image']['#items']->referencedEntities() as $media) {

 //for ($i = 0; $i < count($build['field_pbcrossfade_image']); $i++) {
   // $media = $build['field_pbcrossfade_image'][$i]['#media'];
   if (!is_null($media->field_media_image)) {
     $image_url = file_create_url($media->field_media_image->entity->getFileUri());
     $alt = $media->field_media_image->alt;
     $images_markup .= '<img src="' . $image_url . '" alt="' . $alt . '"/>';
   }
 }

 $build['field_pbcrossfade_image']['#value'] = $images_markup;
}
