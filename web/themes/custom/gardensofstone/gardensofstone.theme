/**
 * Implements hook_theme().
 */
function gardensofstone_theme($existing, $type, $theme, $path) {
  $theme_registry = [];

  // Register component templates from theme root.
  $components = ['coxs-campaign', 'watershed-feature'];
  foreach ($components as $component) {
    $template_path = $path . '/' . $component . '.html.twig';
    if (file_exists($template_path)) {
      $variables = [];
      if ($component === 'coxs-campaign') {
        $variables = ['video_url' => '', 'video_title' => '', 'episode_blurb' => '', 'thumbnail_url' => '', 'show_footer' => TRUE];
      } elseif ($component === 'watershed-feature') {
        $variables = ['title' => '', 'kicker' => '', 'blurb' => '', 'video_url' => '', 'thumbnail_url' => '', 'campaign_url' => '#', 'campaign_label' => 'Read the campaign'];
      }
      $theme_registry[$component] = [
        'variables' => $variables,
        'template' => $component,
      ];
    }
  }

  return $theme_registry;
}
