{#
/**
 * @file
 * Theme implementation to display a journey section paragraph using Layout Paragraphs.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 */
#}
{% set classes = [
    'paragraph',
    'paragraph--type--journey-section',
    'section',
    'journey-section',
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
] %}

{% block paragraph %}
    <section id="journey"{{ attributes.addClass(classes) }}>
        <div class="wrap container">

            {# Safe rendering wrappers to prevent empty markup #}
            {% if (not paragraph.field_pbjourney_kicker.isEmpty()) or
                (not paragraph.field_pbjourney_title.isEmpty()) or
                (not paragraph.field_pbjourney_body.isEmpty()) %}
                <div class="intro">

                    {% if not paragraph.field_pbjourney_kicker.isEmpty() %}
                        <div class="kicker">
                            {{ content.field_pbjourney_kicker }}
                        </div>
                    {% endif %}

                    {% if not paragraph.field_pbjourney_title.isEmpty() %}
                        <h2 class="title">
                            {{ content.field_pbjourney_title }}
                        </h2>
                    {% endif %}

                    {% if not paragraph.field_pbjourney_body.isEmpty() %}
                        <div class="body-content">
                            {{ content.field_pbjourney_body }}
                        </div>
                    {% endif %}

                </div>
            {% endif %}

            {#
            Layout Paragraphs tracks require careful rendering. Ensure your
            core.entity_view_display.paragraph.journey_section.default config
            is also set to use the layout_paragraphs formatter if available.
            #}
            <div class="journey-track">
                {% if not paragraph.field_pbjourney_stops.isEmpty() %}
                    {{ content.field_pbjourney_stops }}
                {% endif %}
            </div>

        </div>
    </section>
{% endblock paragraph %}
