{#
/**
 * @file
 * Theme implementation to display a hero campaign paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--hero-campaign',
    'hero',
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      <div class="wrap{{ attributes.addClass('wrap') }}">
        <div>
          {% if content.field_pbhero_campaign_tag %}
            <div class="eyebrow-line">
              <span class="dot"></span>
              {{ content.field_pbhero_campaign_tag }}
            </div>
          {% endif %}
          {% if content.field_pbhero_campaign_headline %}
            <h1 class="headline">{{ content.field_pbhero_campaign_headline }}</h1>
          {% endif %}
          {% if content.field_pbhero_campaign_intro %}
            <p class="sub">{{ content.field_pbhero_campaign_intro }}</p>
          {% endif %}
          <div class="hero-ctas">
            {% if content.field_pbhero_campaign_primary_btn and content.field_pbhero_campaign_primary_btn_url %}
              <a class="btn-primary" href="{{ content.field_pbhero_campaign_primary_btn_url }}">{{ content.field_pbhero_campaign_primary_btn }}</a>
            {% endif %}
            {% if content.field_pbhero_campaign_ghost_btn and content.field_pbhero_campaign_ghost_btn_url %}
              <a class="btn-ghost" href="{{ content.field_pbhero_campaign_ghost_btn_url }}">{{ content.field_pbhero_campaign_ghost_btn }}</a>
            {% endif %}
          </div>
          {% if content.field_pbhero_campaign_scroll_cue %}
            <div class="scroll-cue">
              {% if content.field_pbhero_campaign_scroll_cue_url %}
                <a href="{{ content.field_pbhero_campaign_scroll_cue_url }}">See how the water gets here &darr;</a>
              {% else %}
                <span>See how the water gets here &darr;</span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endblock %}
  </div>
{% endblock paragraph %}
