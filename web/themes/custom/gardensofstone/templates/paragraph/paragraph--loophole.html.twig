{#
/**
 * @file
 * Theme implementation to display a loophole section paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 * - content: All paragraph items.
 * - attributes: HTML attributes for the containing element.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--loophole',
    'loophole-section',
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>
    {% block content %}
      <div class="wrap container">
        {% if not paragraph.field_pbloophole_kicker.isEmpty() %}
          <div class="kicker">{{ content.field_pbloophole_kicker }}</div>
        {% endif %}
        {% if not paragraph.field_pbloophole_title.isEmpty() %}
          <h2 class="title">{{ content.field_pbloophole_title }}</h2>
        {% endif %}
        {% if not paragraph.field_pbloophole_standout_lede.isEmpty() %}
          <div class="standout-lede">{{ content.field_pbloophole_standout_lede }}</div>
        {% endif %}
        {% if not paragraph.field_pbloophole_lede.isEmpty() %}
          <div class="lede">{{ content.field_pbloophole_lede }}</div>
        {% endif %}
        {% if not paragraph.field_pbloophole_stats.isEmpty() %}
          <div class="stat-row">
            {{ content.field_pbloophole_stats }}
          </div>
        {% endif %}
        {% if not paragraph.field_pbloophole_close.isEmpty() %}
          <div class="loophole-close">{{ content.field_pbloophole_close }}</div>
        {% endif %}
        {% if not paragraph.field_pbloophole_copy_note.isEmpty() %}
          <div class="copy-note">{{ content.field_pbloophole_copy_note }}</div>
        {% endif %}
      </div>
    {% endblock %}
  </div>
{% endblock paragraph %}
